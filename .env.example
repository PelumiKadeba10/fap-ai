# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by the volunteer page to update a delivery by its link token.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API: console.anthropic.com. Without it, intake falls back to the offline parser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Public URL of the app, used in volunteer links (no trailing slash)
SITE_URL=http://localhost:3000
